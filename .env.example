# ===== Base de datos (Supabase Postgres) =====
# Copia la cadena desde Supabase: Project > Connect > "Session pooler" (recomendado si tu red no tiene IPv6).
# Si tu contraseña tiene caracteres especiales (@ : / # ?), codifícala en formato URL.
# Conexión directa:  postgresql://postgres:TU_PASSWORD@db.twhkiymjvhnutnwawrzg.supabase.co:5432/postgres
# Session pooler:    postgresql://postgres.twhkiymjvhnutnwawrzg:TU_PASSWORD@aws-0-us-west-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.twhkiymjvhnutnwawrzg.supabase.co:5432/postgres
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# ===== JWT =====
# Genera una clave con:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=backend-jwt
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== Seguridad de login =====
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
REQUIRE_VERIFIED_EMAIL=false
ALLOW_REGISTRATION=true
DEFAULT_ROLE=viewer

# ===== Otros =====
# Solo en desarrollo: devuelve en la respuesta los tokens de verificación/reset (en producción se enviarían por email).
EXPOSE_DEBUG_TOKENS=true
# Orígenes permitidos para CORS, separados por coma
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
